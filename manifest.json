{
  "manifest_version": 3,
  "name": "Eagle 素材导入助手",
  "version": "1.4.5",
  "description": "自动识别网页图片素材，可逐个或批量选择 Eagle 文件夹导入。",
  "permissions": ["activeTab", "contextMenus", "storage", "scripting", "alarms", "clipboardRead", "debugger", "declarativeNetRequestWithHostAccess", "downloads", "downloads.ui"],
  "host_permissions": ["http://localhost:41595/*", "<all_urls>"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Eagle 素材导入助手"
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Ctrl+Shift+E",
        "mac": "Command+Shift+E"
      },
      "description": "打开 Eagle 素材导入面板"
    },
    "auto_import": {
      "suggested_key": {
        "default": "Ctrl+Shift+K",
        "mac": "Command+Shift+K"
      },
      "description": "一键复制画板 PNG 并导入 Eagle（画布类设计工具）"
    },
    "clipboard_import": {
      "suggested_key": {
        "default": "Ctrl+Shift+L",
        "mac": "Command+Shift+L"
      },
      "description": "把剪贴板里的图片导入 Eagle（多选/手动复制后用）"
    }
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
